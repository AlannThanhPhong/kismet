MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB=mo_wedding

# Google OAuth web client. Set the matching callback URI in Google Cloud Console.
# Keep the client secret server-only; never add NEXT_PUBLIC_ or commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to the current site's /api/auth/google/callback URL.
GOOGLE_REDIRECT_URI=
# Server-side Cloudinary image uploads for photos used in exported invitations.
# Keep the API secret private; do not prefix these variables with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: HTML-tag verification for a URL-prefix property in Google Search Console.
# Copy only the content value, not the entire <meta> tag. Rebuild/redeploy after setting.
# Domain properties use DNS verification instead and do not require this variable.
GOOGLE_SITE_VERIFICATION=
