# Optional: HTML-tag verification for a URL-prefix property in Google Search Console.
# Copy only the content value, not the entire <meta> tag. Rebuild/redeploy after setting.
# Domain properties use DNS verification instead and do not require this variable.
GOOGLE_SITE_VERIFICATION=
